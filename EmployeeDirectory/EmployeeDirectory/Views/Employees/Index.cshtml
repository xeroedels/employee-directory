@model EmployeeDirectory.ViewModels.EmployeeListViewModel

@{
    ViewData["Title"] = "Employee Directory";
}

<h2 class="mb-4">Employee Directory</h2>

<form asp-action="Index" method="GET">
    <input type="text" name="searchTerm"
placeholder="Search employees" value="@Model.SearchTerm"/>
    <button type="submit">Search</button>

    <button type="submit" name="minSalary" value="6000000" class="btn btn-primary">
        Salary
    </button>
</form>


<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>Job Title</th>
            <th>Email</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

@foreach(var employee in Model.Employees)
{
        <tr>
            <td>@employee.FirstName</td>
            <td>@employee.LastName</td>
            <td>@employee.Department</td>
            <td>@employee.JobTitle</td>
            <td>@employee.Email</td>
            <td>@employee.Salary.ToString("N2")</td>
            <td>@employee.HireDate.ToShortDateString()</td>
            <td><button class="btn btn-danger btn-sm delete-btn"
            data-id="@employee.Id">
                Delete
            </button></td>
        </tr>
}

    </tbody>

</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div>
        <strong>Total Records: </strong> 
        <span id="totalRecords">@Model.TotalRecords</span>
    </div>

    <div>
        <strong>Page @Model.CurrentPage of @Model.TotalPages</strong>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                asp-action="Index"
                asp-route-page="@(Model.CurrentPage - 1)"
                asp-route-searchTerm="@Model.SearchTerm">
                    Previous
                </a>
            </li>
        }
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                asp-action="Index"
                asp-route-page="@i"
                asp-route-searchTerm="@Model.SearchTerm">
                @i
                </a>
            </li>
        }

        @if(Model.CurrentPage < Model.TotalPages){
            <li class="page-item">
                <a class="page-link"
                asp-action="Index"
                asp-route-page="@(Model.CurrentPage + 1)"
                asp-route-searchTerm="@Model.SearchTerm"
                >
                Next
                </a>
            </li>
        }
    </ul>
</nav>

@section Scripts
{
    <script src="~/js/employee.js"></script>
}